# Force HTTPS + www: every variant -> https://www.blackmobiledetailing.com
RewriteEngine On

RewriteCond %{HTTP_HOST} ^blackmobiledetailing\.com$ [NC]
RewriteRule ^(.*)$ https://www.blackmobiledetailing.com/$1 [R=301,L]

RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.blackmobiledetailing.com/$1 [R=301,L]
